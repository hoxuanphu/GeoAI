{
  "components": {
    "schemas": {
      "CapabilitiesResponse": {
        "additionalProperties": false,
        "properties": {
          "execution_owner_ready": {
            "const": false,
            "default": false,
            "title": "Execution Owner Ready",
            "type": "boolean"
          },
          "features": {
            "default": [
              "health",
              "capabilities"
            ],
            "items": {
              "enum": [
                "health",
                "capabilities"
              ],
              "type": "string"
            },
            "title": "Features",
            "type": "array"
          },
          "inference_ready": {
            "const": false,
            "default": false,
            "title": "Inference Ready",
            "type": "boolean"
          },
          "native_launcher_ready": {
            "const": false,
            "default": false,
            "title": "Native Launcher Ready",
            "type": "boolean"
          },
          "project_writer_ready": {
            "const": false,
            "default": false,
            "title": "Project Writer Ready",
            "type": "boolean"
          },
          "runtime": {
            "const": "python-local-metadata",
            "default": "python-local-metadata",
            "title": "Runtime",
            "type": "string"
          },
          "schema_version": {
            "const": "0.1.0",
            "default": "0.1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "technical_ready": {
            "const": true,
            "default": true,
            "title": "Technical Ready",
            "type": "boolean"
          }
        },
        "title": "CapabilitiesResponse",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "app_version": {
            "minLength": 1,
            "title": "App Version",
            "type": "string"
          },
          "schema_version": {
            "const": "0.1.0",
            "default": "0.1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "app_version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "SessionDescriptor": {
        "additionalProperties": false,
        "description": "Private native/dev pipe handoff only; never durable project metadata.",
        "properties": {
          "base_url": {
            "pattern": "^http://127\\.0\\.0\\.1:[1-9][0-9]{0,4}$",
            "title": "Base Url",
            "type": "string"
          },
          "token": {
            "maxLength": 256,
            "minLength": 20,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "base_url",
          "token"
        ],
        "title": "SessionDescriptor",
        "type": "object",
        "x-geoai-private-runtime": true
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "GeoAI local foundation",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/capabilities": {
      "get": {
        "operationId": "getCapabilities",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilitiesResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Capabilities"
      }
    },
    "/v1/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Health"
      }
    }
  }
}
